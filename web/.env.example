# Lumen Marketplace (web) — copy to web/.env.local for local, or export on droplet
#
# Secrets: reuse from Strom/lumen (BACKEND/.env or deploy /opt/strom/.env /
# influencers host /opt/lumen-marketplace/.env). Do NOT create new TikHub/OpenRouter accounts.
# Never commit real keys.

# Modes: demo (default) | live
DISCOVERY_MODE=demo
PRODUCT_SCAN_MODE=demo
NEXT_PUBLIC_DISCOVERY_MODE=demo
NEXT_PUBLIC_PRODUCT_SCAN_MODE=demo

# TikHub (server only — never NEXT_PUBLIC_)
# Primary discovery = Douyin POST /api/v1/douyin/search/fetch_general_search_v1
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io

# OpenRouter LLM product scan (server only) — reuse from Strom/lumen
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Auth + SQLite persistence (brand login)
AUTH_SECRET=change-me-in-production
# true only behind HTTPS (HTTP demo droplet must stay false)
COOKIE_SECURE=false
DATABASE_URL="file:./data/lumen.db"

# Creator identity = Act-as Douyin (no intl TikTok OAuth)
NEXT_PUBLIC_APP_URL=https://influencers.lumen.universalgravity.org
