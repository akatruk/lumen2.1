# Lumen Marketplace (web) — copy to web/.env.local for local, or export on droplet

# Modes: demo (default) | live
DISCOVERY_MODE=demo
PRODUCT_SCAN_MODE=demo
NEXT_PUBLIC_DISCOVERY_MODE=demo
NEXT_PUBLIC_PRODUCT_SCAN_MODE=demo

# TikHub (server only — never NEXT_PUBLIC_)
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io

# OpenRouter LLM product scan (server only)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Auth + SQLite persistence
AUTH_SECRET=change-me-in-production
# true only behind HTTPS (HTTP demo droplet must stay false)
COOKIE_SECURE=false
DATABASE_URL="file:./data/lumen.db"

# TikTok creator OAuth (reuse Strom TikTok Developer App + new redirect URI)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://influencers.lumen.universalgravity.org/api/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic
NEXT_PUBLIC_APP_URL=https://influencers.lumen.universalgravity.org
CREATOR_AUTH_REQUIRED=false
