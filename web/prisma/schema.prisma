datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("brand")
  createdAt    DateTime  @default(now())
  products     Product[]
}

model Product {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  brand             String
  category          String
  description       String
  imageEmoji        String   @default("📦")
  priceLabel        String   @default("TBD")
  geographyJson     String   @default("[]")
  audience          String   @default("")
  languagesJson     String   @default("[\"en\"]")
  benefitsJson      String   @default("[]")
  prohibitedJson    String   @default("[]")
  desiredTopicsJson String   @default("[]")
  platformsJson     String   @default("[\"tiktok\"]")
  resumeCardJson    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DiscoveryCache {
  id        String   @id @default(cuid())
  queryKey  String   @unique
  payload   String
  createdAt DateTime @default(now())
  expiresAt DateTime
}
