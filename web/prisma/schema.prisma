datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         String          @default("brand")
  createdAt    DateTime        @default(now())
  products     Product[]
  shortlists   Shortlist[]
  invitations  Invitation[]
  briefs       CampaignBrief[]
}

model Product {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  brand             String
  category          String
  description       String
  imageEmoji        String   @default("📦")
  priceLabel        String   @default("TBD")
  geographyJson     String   @default("[]")
  audience          String   @default("")
  languagesJson     String   @default("[\"en\"]")
  benefitsJson      String   @default("[]")
  prohibitedJson    String   @default("[]")
  desiredTopicsJson String   @default("[]")
  platformsJson     String   @default("[\"tiktok\"]")
  resumeCardJson    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Shortlist {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  productId  String?
  campaignId String?
  notes      String   @default("")
  itemsJson  String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Invitation {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencerId String
  campaignId   String
  status       String          @default("Pending")
  message      String
  respondedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  briefs       CampaignBrief[]
}

model CampaignBrief {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationId     String
  invitation       Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  campaignId       String
  influencerId     String
  title            String
  deliverablesJson String     @default("[]")
  messaging        String
  restrictionsJson String     @default("[]")
  deadline         String
  approvalRules    String
  status           String     @default("Sent")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model DiscoveryCache {
  id        String   @id @default(cuid())
  queryKey  String   @unique
  payload   String
  createdAt DateTime @default(now())
  expiresAt DateTime
}
